[MAIN]
ignore=third_party
jobs=2
disable=
    missing-docstring,
    missing-module-docstring,
    missing-function-docstring,
    subprocess-run-check,
    no-else-return,
    invalid-name,
    line-too-long,
    too-many-instance-attributes,
    len-as-condition,
    too-few-public-methods,
    anomalous-backslash-in-string,
    simplifiable-if-statement,
    too-many-arguments,
    duplicate-code,
    no-name-in-module,
    no-member,
    raw-checker-failed,
    bad-inline-option,
    locally-disabled,
    file-ignored,
    suppressed-message,
    useless-suppression,
    deprecated-pragma,
    import-error,
    consider-using-enumerate,
    consider-using-f-string,
    protected-access,
    unused-import,
    wrong-import-order,
    disallowed-name,
    unused-argument,
    broad-except,
    too-many-statements,
    too-many-locals,
    too-many-branches,
    unspecified-encoding,
    import-outside-toplevel,
    consider-using-with,
    consider-using-in,
    wildcard-import,
    unused-wildcard-import,
    useless-super-delegation
