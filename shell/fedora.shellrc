#!/usr/bin/env oksh

# fedora-specific aliases
# -*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*

if type rpm-ostree >/dev/null 2>&1 ; then
    pkg() {
        [ "$1" ] || set -- h
        flag=${1#-}
        shift
        case $flag in
            h)
                >&2 echo 'pkg: [-a add] [-u update]'
                ;;
            a)
                sudo rpm-ostree install "$@"
                ;;
            u)
                echo 'Updating flatpak...'
                sudo flatpak update -y

                echo 'Updating rpm-ostree...'
                sudo rpm-ostree refresh-md
                sudo rpm-ostree upgrade
                ;;
            uf)
                # sometimes above fails for some reason --force usually fixes it
                echo 'Updating rpm-ostree with --force...'
                sudo rpm-ostree refresh-md --force
                sudo rpm-ostree upgrade
                ;;
            s)
                rpm-ostree search "$@"
                ;;
            l)
                rpm -qa | sort
        esac
    }
elif type dnf >/dev/null 2>&1 ; then
    pkg() {
        [ "$1" ] || set -- h
        flag=${1#-}
        shift
        case $flag in
            h)
                >&2 printf '%s\n' \
                    'pkg: [-a add] [-u update] [-d delete] [-s search] [-i info] [-f file] [-l list]'
                ;;
            a)
                sudo dnf -q upgrade --refresh
                sudo dnf -q install "$@"
                ;;
            u)
                sudo dnf -q upgrade --refresh
                sudo dnf -q update "$@"
                ;;
            d)
                sudo dnf -q remove "$@"
                ;;
            s)
                dnf -q search "$@"
                ;;
            i)
                dnf -q info "$@"
                ;;
            f)
                dnf -q provides "$@"
                ;;
            l)
                dnf -q list "$@"
        esac
    }
fi

firmware-update() {
    sudo fwupdmgr refresh
    sudo fwupdmgr get-updates
    sudo fwupdmgr update
}

alias kargs-editor='EDITOR=vi sudo rpm-ostree kargs --editor'

