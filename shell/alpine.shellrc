pkg() {
    [ "$1" ] || set -- h
    flag=${1#-}
    shift
    case $flag in
        s|search)
            apk search "$@"
            ;;
        a|add)
            sudo apk update
            sudo apk add "$@"
            ;;
        u|upgrade)
            sudo apk update
            sudo apk upgrade "$@"
            ;;
        d|del)
            sudo apk del "$@"
            ;;
        i|info)
            apk info "$@"
            ;;
        l|list)
            cat /etc/apk/world
            ;;
    esac
}
