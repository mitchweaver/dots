#!/usr/bin/env oksh

pkg() {
    [ "$1" ] || set -- h
    flag=${1#-}
    shift
    case $flag in
        h|help)
            >&2 echo 'Usage: pkg [s search] [a add] [u update] [d delete] [i info] [l list]'
            ;;
        s|search)
            apk search "$@"
            ;;
        a|add)
            sudo apk update
            sudo apk add "$@"
            ;;
        u|upgrade)
            sudo apk update
            sudo apk upgrade "$@"
            ;;
        d|del)
            sudo apk del "$@"
            ;;
        i|info)
            apk info "$@"
            ;;
        l|list)
            cat /etc/apk/world
    esac
}

