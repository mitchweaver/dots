#!/usr/bin/env oksh

if command -v nvidia-smi >/dev/null ; then
    # get driver ver for getting correct flatpak runtime
    alias nvidia-driver-version='nvidia-smi --query-gpu=driver_version --format=csv,noheader'
    alias flatpak-check-nvidia='flatpak list --runtime | grep -i nvidia'
fi

alias flatpak-gl-drivers='flatpak --gl-drivers'

flatpak-fix-nvidia() {
    modinfo -F version nvidia
    nvidia-smi --query-gpu=driver_version --format=csv,noheader
    flatpak list --runtime --columns=application,version | grep GL.nvidia
}

fp() {
    [ "$1" ] || set -- -h

    case $1 in
        h|-h|*help)
            >&2 echo 'Usage: fp [a] [d] [l] [s]'
            ;;
        a|-a|*add)
            shift
            sudo flatpak install "$@"
            ;;
        d|-d|*delete|*remove)
            shift
            sudo flatpak remove "$@"
            ;;
        l|-l|*list)
            # list which flatpak apps were manually installed (ie not from distro default)
            flatpak list --app --columns=name,application,origin,installation
            ;;
        s|-s|*search)
            shift
            flatpak search "$@"
    esac
}

alias fpg='fp -l | grep -i'

# ========================================================================
# flatpak
# ========================================================================
# ai slop to print what permissions each installed flatpak asks for
flatpak_print_perms() {
    for app in $(flatpak list --app --columns=application); do
        flatpak info -M "$app" | awk -v app="$app" -F= '
        /^\[Context\]/ {c=1; next}  /^\[/ {c=0}
        c && $1=="filesystems" {
        n = split($2, a, ";")
        for (i=1; i<=n; i++) { p=a[i]; sub(/:.*/, "", p)
        if (p ~ /^(host|host-os|host-etc|home)$/) hit = hit " " a[i] }
        if (hit) print app ":" hit
        }'
    done
}

# ========================================================================
# aliases below
# ========================================================================

# who designed this garbage
if ! command -v mpv >/dev/null ; then
    if [ -d ~/.var/app/io.mpv.Mpv ] ; then
        alias mpv='flatpak run io.mpv.Mpv'
    fi
fi

