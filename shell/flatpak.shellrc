# get driver ver for getting correct flatpak runtime
alias nvidia-driver-version='nvidia-smi --query-gpu=driver_version --format=csv,noheader'
alias flatpak-check-nvidia='flatpak list --runtime | grep -i nvidia'
alias flatpak-gl-drivers='flatpak --gl-drivers'

flatpak-fix-nvidia() {
    modinfo -F version nvidia
    nvidia-smi --query-gpu=driver_version --format=csv,noheader
    flatpak list --runtime --columns=application,version | grep GL.nvidia
}

# list which flatpak apps were manually installed (ie not from distro default)
alias flatpak-list='flatpak list --app --columns=name,application,origin,installation'

# ========================================================================
# aliases below
# ========================================================================

# who designed this garbage
if ! command -v mpv >/dev/null ; then
    if [ -d ~/.var/app/io.mpv.Mpv ] ; then
        alias mpv='flatpak run io.mpv.Mpv'
    fi
fi

