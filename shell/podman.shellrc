#!/usr/bin/env oksh

PODMAN_NUKE() {
    printf 'This will delete all images and containers, confirm? (y/n): '
    read -r ans
    [ "$ans" = y ] && {
        echo 'REMOVING ALL CONTAINERS AND SETTINGS'

        sudo rm -rf \
            "$HOME/.local/share/containers/storage" \
            "/run/user/$(id -u)/containers" \
            "/run/user/$(id -u)/libpod"

        podman system reset

        echo
        echo 'Checking health...'
        podman info >/dev/null && echo OK
    }
}

podman-fix-sudo() {
    podman exec -u root alpine chown root:root /usr/bin/sudo /etc/sudo.conf
    podman exec -u root alpine chmod 4755 /usr/bin/sudo

    podman exec -u root ubuntu chown root:root /usr/bin/sudo /etc/sudo.conf
    podman exec -u root ubuntu chmod 4755 /usr/bin/sudo
}

