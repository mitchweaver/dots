#!/usr/bin/env oksh

case ${0##*/} in
    *ksh)
        set -o vi-tabcomplete 2>/dev/null ||: # vim emulation mode
        set -o csh-history    2>/dev/null ||: # allow '!bang' style commands
        set -o pipefail       2>/dev/null ||: # exit codes are of right-most command in pipelines
        set -o ignoreeof      2>/dev/null ||: # do not exit on EOF or ^D, require 'exit'
        set -o trackall       2>/dev/null ||: # all commands become tracked aliases
        set -o bgnice         2>/dev/null ||: # all background jobs run at lower priority
        set -o braceexpand    2>/dev/null ||: # allow for 'echo {foo,bar}' bash-style expansions
        ;;
    *bash)
        set -o vi             2>/dev/null ||:
        set -o pipefail       2>/dev/null ||:
        set -o ignoreeof      2>/dev/null ||:
        set -o braceexpand    2>/dev/null ||:
esac

