#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#

# fix for atomic distros that have home at /var/home
# breaks random scripts that might expect a normal /home
[ "$PWD" -ef "$HOME" ] && cd "$HOME"

# import profile if it wasn't ran already
if [ -z "$DOT_PROFILE_IMPORTED" ] ; then
    [ -f ~/.profile ] && . ~/.profile
fi

# stop .core file generation
ulimit -c 0

# cause all newly created files to be unreadable by other users
umask 0077

# -*-*- Options -*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*
SHELLRC_DIR="$HOME/src/dots/shell"
# PS1_STYLE=pwd-no-prompt  # [user-pwd/user/pwd/user-host-pwd]
PS1_STYLE=user-host-pwd  # [user-pwd/user/pwd/user-host-pwd]
# PS1_STYLE=user-pwd       # [user-pwd/user/pwd/user-host-pwd]
# PS1_STYLE=pwd            # [user-pwd/user/pwd/user-host-pwd]
PS1_GIT=true             # [true/false]

HISTORY_STYLE=default      # [default/per-shell]
export HISTSIZE=300
export HISTFILE="$HOME/.cache/ksh_history"
[ -d ~/.cache ] || mkdir -p ~/.cache
# -*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*

if [ -d "$SHELLRC_DIR" ] ; then
    if command -v freebsd-update >/dev/null ; then
        [ -f "$SHELLRC_DIR/freebsd.shellrc" ] && . "$SHELLRC_DIR/freebsd.shellrc"
    elif command -v pkg_add >/dev/null ; then
        [ -f "$SHELLRC_DIR/openbsd.shellrc" ] && . "$SHELLRC_DIR/openbsd.shellrc"
    elif command -v emerge >/dev/null ; then
        [ -f "$SHELLRC_DIR/gentoo.shellrc" ] && . "$SHELLRC_DIR/gentoo.shellrc"
    elif command -v dnf >/dev/null || command -v rpm-ostree >/dev/null ; then
        [ -f "$SHELLRC_DIR/fedora.shellrc" ] && . "$SHELLRC_DIR/fedora.shellrc"
    elif command -v apk >/dev/null ; then
        [ -f "$SHELLRC_DIR/alpine.shellrc" ] && . "$SHELLRC_DIR/alpine.shellrc"
    elif command -v brew >/dev/null ; then
        [ -f "$SHELLRC_DIR/macos.shellrc" ] && . "$SHELLRC_DIR/macos.shellrc"
    fi

    if [ -e /proc/sys/kernel/ostype ] ; then
        if read -r os 2>/dev/null </proc/sys/kernel/ostype && [ "$os" = Linux ] ; then
            . "$SHELLRC_DIR/linux.shellrc"
        fi
    fi

    if command -v docker >/dev/null ; then
        [ -f "$SHELLRC_DIR/docker.shellrc" ] && . "$SHELLRC_DIR/docker.shellrc"
    fi

    if command -v zfs >/dev/null ; then
        [ -f "$SHELLRC_DIR/zfs.shellrc" ] && . "$SHELLRC_DIR/zfs.shellrc"
    fi

    for file in \
        builtins \
        development \
        flatpak \
        generic_aliases \
        generic_functions \
        history \
        movement \
        networking \
        options \
        prompt \
        wasteland
    do
        [ -f "$SHELLRC_DIR/$file.shellrc" ] && . "$SHELLRC_DIR/$file.shellrc"
    done
fi

