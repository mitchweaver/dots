#!/usr/bin/env oksh

# excludes here are to stop me from copying podman containers which breaks things
alias rsync='rsync -avhu --info=progress2 --delete --partial --links --exclude=".local/share/containers" --exclude="/.local/share/containers"'

############ for fat32
############ alias fatsync='rsync -rvhu --progress --delete --partial'

alias scp='scp -rp'

alias pign=ping
alias nsl=nslookup

alias p8='ping 8.8.8.8'
alias p1='ping 1.1.1.1'

alias ssh='TERM=xterm-256color ssh'

# shellcheck disable=SC2139
alias {vssh,vissh}='${EDITOR:-vi} ~/.ssh/config'

# scan for open ports
alias ssports='sudo ss -tulpn'
####### alias portscan='sudo nmap -sT'

flushdns() {
    # systemctl
    if command -v resolvectl >/dev/null && ! pgrep -fa dnsmasq ; then
        resolvectl flush-caches
    # dnsmasq
    elif command -v dnsmasq >/dev/null ; then
        if command -v rc-service >/dev/null ; then
            sudo rc-service dnsmasq restart
        elif command -v systemctl >/dev/null ; then
            sudo systemctl restart dnsmasq
            sudo resolvectl flush-caches
        fi
    # macos
    elif command -v dscacheutil >/dev/null ; then
        dscacheutil -flushcache; sudo killall -HUP mDNSResponder
    fi
}

alias wtf='w3m -dump https://wtfismyip.com/json | jq -r'

# grab urls of any running processes
psurls() {
    ps -auxww | urls
}

if command -v systemctl >/dev/null ; then
    # systemd-resolved
    alias resolved-status="systemd-resolve --status"
    alias resolved-statistics="systemd-resolve --statistics"
    alias resolved-write="pkill -USR1 systemd-resolve"
    alias resolved-flush="resolvectl flush-caches"
fi

# ========================================================================
# WPA_SUPPLICANT
# ========================================================================
if command -v wpa_supplicant >/dev/null ; then
    alias wpscan='sudo wpa_cli scan'
fi

# ========================================================================
# TOR
# ========================================================================
if command -v torsocks >/dev/null ; then
    alias torsocks='torsocks -i'
    alias torshell='torsocks -i --shell'
    alias torcheck='curl -x socks5h://localhost:9050 -s https://check.torproject.org | lynx -dump -stdin'
    alias torget='torsocks -i wget'
fi

# ========================================================================
# wireguard
# ========================================================================
alias wg-up='wg-quick up wg0.conf'
alias wg-down='wg-quick down wg0.conf'
alias wg-import='nmcli connection import type wireguard file'

