# exclude podman containers in case im syncing my home dir because it will fail
alias rsync='rsync -avhu --progress --delete --partial --links --exclude=/.local/share/containers'

# for fat32
alias fatsync='rsync -rvhu --progress --delete --partial'

alias scp='scp -rp'

alias pign=ping
alias nsl=nslookup

alias p8='ping 8.8.8.8'
alias p1='ping 1.1.1.1'

alias ssh='TERM=xterm-256color ssh'

alias {vssh,vissh}='${EDITOR:-vi} ~/.ssh/config'

# scan for open ports
alias portscan='nmap -sT'

flushdns() {
    if command -v resolvectl > /dev/null ; then
        resolvectl flush-caches
    elif command -v rc-service >/dev/null && command -v dnsmasq >/dev/null ; then
        sudo rc-service dnsmasq restart
    fi
}

wtf() {
    w3m -dump https://wtfismyip.com/json | jq -r
}

# grab urls of any running processes
# see: http://github.com/mitchweaver/bin for urls script
psurls() { ps -auxww | urls ; }

isconnected() {
    if ifconfig $int | grep 'no network' >/dev/null ; then
        return 1
    fi
}

if command -v systemctl >/dev/null ; then
    # systemd-resolved
    alias resolved-status="systemd-resolve --status"
    alias resolved-statistics="systemd-resolve --statistics"
    alias resolved-write="pkill -USR1 systemd-resolve"
    alias resolved-flush="resolvectl flush-caches"
fi

dl() {
    if [ "$2" ] ; then
        wget -nv -c --no-cookies --no-hsts "$1" -O "$2"
    elif [ "$1" ] ; then
        wget -nv -c --no-cookies --no-hsts "$1"
    fi
}

# ========================================================================
# WPA_SUPPLICANT
# ========================================================================
if command -v wpa_supplicant >/dev/null ; then
    alias wpscan='sudo wpa_cli scan'
fi

# ========================================================================
# TOR
# ========================================================================
if command -v torsocks >/dev/null ; then
    alias torsocks='torsocks -i'
    alias torshell='torsocks -i --shell'
    alias torcheck='curl -x socks5h://localhost:9050 -s https://check.torproject.org | lynx -dump -stdin'
    alias torget='torsocks -i wget'
fi

# ========================================================================
# wireguard
# ========================================================================
alias wg-up='wg-quick up /etc/wireguard/wvr.sh.conf'
alias wg-down='wg-quick down /etc/wireguard/wvr.sh.conf'

