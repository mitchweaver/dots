# because i cant remember these
alias sway-outputs='swaymsg -t get_outputs'
alias sway-tree='swaymsg -t get_tree'
alias sway='sh ~/src/bin/misc/launch_sway.sh'
alias swaycfg='v ~/.config/sway/config'
alias waybarcfg='v ~/.config/waybar/config'

alias ytdl-mp3='youtube-dl -x --audio-format mp3'

kittyfonts() { kitty +list-fonts --psnames | g "$*" ; }

sensors(){
    watch -n 1 "command sensors | grep 'Core ' 2>/dev/null | grep -vE '(E|e)rror' | sed 's/(.*//'"
}

alias fix-spotify='rm -r ~/.var/app/com.spotify.Client/cache'

if command -v nvidia-smi >/dev/null ; then
    nvidia-vram() {
        # shellcheck disable=SC2046
        set -- $(nvidia-smi  | grep MiB | head -n 1  | sed 's/.*W//')
        printf '%s\n' "$2/$4"
    }
    alias gputemp="nvidia-smi  -q | grep 'GPU Current Temp' | trim"
fi

