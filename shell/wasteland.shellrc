# -*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*
alias {htop,htpo}='htop -d 10 -s PERCENT_CPU'
alias hme="htop -u $USER"
alias hroot='htop -u root'
alias hf='htop -F'
alias iotop='iotop -d 1 -o -P'

# -*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*
# youtube-dl / ffmpeg
# -*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*

# find res of a video file
alias res='ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=s=x:p=0'

alias youtube-dl='yt-dlp'
ytdl() {
    youtube-dl --no-playlist -c -R 50 --geo-bypass --prefer-ffmpeg -o '%(title)s.%(ext)s' "$@"
}

# removes audio from a video clip
removeaudio() {
    [ -f "$1" ] || return 1
    tmp=/tmp/$RANDOM.${1##.*}
    ffmpeg -i "$1" -c copy -an "$tmp" &&
    mv -f "$tmp" "${2:-out.mp4}"
}

# -*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*
# imagemagick
# -*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*
jpg() {
    if [ -f "$1" ] ; then
        jpegoptim -p -t -w $(($(nproc) / 2)) "$1"
    elif [ -d "${1:-.}" ] ; then
        printf 'This will recursively jpegoptim in current directory: %s\n' "$PWD"
        printf 'Confirm? (y/n):'
        read -r ans
        case $ans in
            *y*)
                find "${1:-.}" -type f -iname "*.jp*" -exec jpegoptim -p -t -w $(($(nproc) / 2)) {} \;
        esac
    fi
}

jpg-strip() {
    if [ -f "$1" ] ; then
        jpegoptim -s -p -t -w $(($(nproc) / 2)) "$1"
    elif [ -d "${1:-.}" ] ; then
        printf 'This will recursively jpegoptim in current directory: %s\n' "$PWD"
        printf 'Confirm? (y/n):'
        read -r ans
        case $ans in
            *y*)
                find "${1:-.}" -type f -iname "*.jp*" -exec jpegoptim -s -p -t -w $(($(nproc) / 2)) {} \;
        esac
    fi
}

# -*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*
# translate-shell
# -*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*
trans() { command trans -no-auto -b "$*" 2>/dev/null ; }
rtrans() { c="$1" ; shift ; command trans -from en -to "$c" "$*" 2>/dev/null ; }
rde() { rtrans de "$*" ; }
rja() { rtrans ja "$*" ; }
rru() { rtrans ru "$*" ; }

alias sshcfg='v ~/.ssh/config'
alias vimrc='v ~/.vimrc'
alias kittycfg='v ~/.config/kitty/kitty.conf'
alias i3cfg='v ~/.config/i3/config'

alias detox='detox -v'

cuesplit() {
    case $1 in
        *h|*help)
            >&2 echo 'usage: cuesplit file.cue file.flac'
            return
            ;;
        *.cue)
            ;;
        *)
            return
    esac
    case $2 in
        *.flac|*.wav)
            ;;
        *)
            echo '$2 is not a flac/wav'
            return
    esac
    shnsplit -f "$1" -o "flac flac -s -8 -o %f -" "$2" &&
    mv -v "$2" /tmp/ &&
    cuetag.sh "$1" -- *.flac
}

alias progress='progress -w -M'

alias stop_typing_it_wrong_idiot="su -c faillock --user $USER --reset"

if command -v apt > /dev/null ; then
    alias  update='sudo apt update; sudo apt upgrade -y ; sudo apt dist-upgrade -y ; sudo apt clean'
fi

nf() {
    # kinoite logo is so ugly
    logo=
    if command -v rpm-ostree >/dev/null ; then
        logo='--logo fedora'
    fi
    if type fastfetch >/dev/null 2>&1 ; then
        fastfetch $logo
    elif type neofetch >/dev/null 2>&1 ; then
        neofetch $logo
    fi
    unset logo
}
alias ff=nf

alias {zramctl,zram}='zramctl --output-all'

