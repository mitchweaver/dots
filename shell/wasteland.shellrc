# -*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*
ranger() {
    if command -v ranger >/dev/null ; then
        if [ "$RANGER_LEVEL" ]; then
            exit
        else
            command ranger "$@"
        fi
    fi
}
