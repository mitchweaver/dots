#!/usr/bin/env oksh

alias csgo='cd /var/home/mitch/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/Counter-Strike Global Offensive'
alias csgo-autoexec='nvim /var/home/mitch/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/Counter-Strike Global Offensive/game/csgo/cfg/autoexec.cfg'

alias steam-find-bad-shaders="find ~/.var/app/com.valvesoftware.Steam -type d -path '*shadercache*' 2>/dev/null"

fix-steam-clear-shadercache() {
    rm -rf ~/.cache/mesa_shader_cache
    rm -rf ~/.cache/nvidia
    rm -rf ~/.nv
    rm -rf ~/.var/app/com.valvesoftware.Steam/cache/mesa_shader_cache*
    rm -rf ~/.var/app/com.valvesoftware.Steam/.steam/steam/steamapps/shadercache
    rm -rf ~/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/shadercache/730
}

